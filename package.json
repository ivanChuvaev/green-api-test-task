{
  "name": "green-api-test-task",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@11.1.3",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:install": "playwright install chromium",
    "lint": "pnpm run lint:js && pnpm run lint:css",
    "lint:js": "oxlint",
    "lint:css": "stylelint \"src/**/*.scss\"",
    "lint:css:fix": "stylelint \"src/**/*.scss\" --fix",
    "lint:staged": "lint-staged",
    "lint:fix": "prettier --write \"src/**/*.{ts,tsx,scss}\"",
    "prepare": "husky",
    "preview": "vite preview",
    "deploy": "pnpm run build && pnpm dlx wrangler deploy",
    "deploy:check": "pnpm dlx wrangler deploy --dry-run"
  },
  "dependencies": {
    "@maxhub/max-ui": "0.5.0",
    "@tanstack/react-virtual": "^3.14.13",
    "clsx": "^2.1.1",
    "prosemirror-commands": "^1.7.2",
    "prosemirror-history": "^1.5.0",
    "prosemirror-keymap": "^1.2.3",
    "prosemirror-model": "^1.25.12",
    "prosemirror-state": "^1.4.4",
    "prosemirror-view": "^1.42.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-toastify": "^11.1.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "husky": "^9.1.7",
    "jsdom": "^30.1.1",
    "lint-staged": "^17.5.1",
    "oxlint": "^1.85.0",
    "prettier": "^3.9.9",
    "sass-embedded": "^1.105.0",
    "stylelint": "^17.15.0",
    "stylelint-config-recommended": "^18.0.0",
    "stylelint-config-recommended-scss": "^17.0.1",
    "stylelint-scss": "^7.3.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vite-plugin-svgr": "^5.2.0",
    "vitest": "^5.0.1"
  }
}
