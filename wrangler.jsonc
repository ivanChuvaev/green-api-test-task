{
  // The app is a plain static SPA: no Worker code, no `main`, no `build` command
  // is needed — Wrangler uploads `dist/` as-is and serves it from the edge.
  // `single-page-application` keeps deep links working even though the app
  // currently routes login/chat internally.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "green-api-messenger",
  "compatibility_date": "2026-09-26",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
