# Credentials for the end-to-end tests only.
#
# They are never bundled: Vite only inlines variables prefixed with `VITE_`,
# and the app deliberately asks the user to type the instance credentials in
# the login form instead of reading them from the environment.
#
# Copy this file to `.env` and fill in the values from the GREEN-API cabinet.
# `.env` is git-ignored; this template is committed.

# API host of the instance, without a trailing slash.
E2E_GREEN_API_URL=https://api.green-api.com

# Instance number from the personal cabinet.
E2E_GREEN_API_ID_INSTANCE=

# Instance access token from the personal cabinet.
E2E_GREEN_API_TOKEN=

# Phone number the test opens a chat with. It must have an account in the
# messenger, otherwise CheckAccount returns `exist: false` and the test fails.
# Self-chat (the instance's own number) is the least intrusive option.
E2E_RECIPIENT_PHONE=
